# Postgres (docker-compose maps to 5433)
DATABASE_URL=postgres://catalogforge:catalogforge@localhost:5433/catalogforge
# Redis with AOF persistence (docker-compose maps to 6380)
REDIS_URL=redis://localhost:6380

# --- AI provider -----------------------------------------------------------
# OpenCode Go subscription key (default provider when set). Leave all keys empty for demo mode.
OPENCODE_API_KEY=
# Optional: Groq key, used only when no OpenCode key is set (free tier is heavily rate limited)
GROQ_API_KEY=
# Optional override: opencode | groq | fake (default: OpenCode if its key is set, else Groq, else fake)
AI_PROVIDER=
# Optional: comma-separated OpenCode Go model chains per tier (first model with quota left serves the call)
# OPENCODE_MODELS_CHEAP=mimo-v2.6-flash,mimo-v2.5,minimax-m3.1-flash-free,longcat-2.5-preview-free
# OPENCODE_MODELS_STRONG=mimo-v2.5,mimo-v2.6-flash,minimax-m3.1-flash-free,longcat-2.5-preview-free
# OPENCODE_MODELS_VISION=qwen3.8-flash,minimax-m3.1-flash-free,mimo-v2.6-flash
# (deepseek-v4.1-flash has the largest allowance but needs the workspace's "Global" region in OpenCode Privacy settings)

# Local file storage for uploads and photos
STORAGE_DIR=./storage
# Public base URL of the web app (used for webhook payloads and photo URLs)
APP_URL=http://localhost:3000
# Parallel AI calls per worker process (raise for providers without per-minute limits, e.g. 8 / 8 on OpenCode Go)
WORKER_BUILD_CONCURRENCY=4
WORKER_TRANSLATE_CONCURRENCY=2
# Speed tuning: products per build call, fields per translate call, worker DB connections
BUILD_BATCH_SIZE=5
TRANSLATE_BATCH_ITEMS=15
DB_POOL_WORKER=8
