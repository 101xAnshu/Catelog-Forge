# Copy to .env and fill in. Never commit .env.
# The compose file forces SEED_DEMO=false and wires DATABASE_URL/REDIS_URL for the Docker network.

# --- Hostnames -------------------------------------------------------------
# sslip.io maps the dashed IP back to the Lightsail static IP, so Caddy can issue a real cert.
APP_URL=https://15-135-152-250.sslip.io
CADDY_DOMAIN=15-135-152-250.sslip.io

# --- Secrets ---------------------------------------------------------------
# Long random alphanumeric string (no @ or /, it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password' | base64 -w0
# Caddy expects the base64-encoded bcrypt hash. Keep the single quotes in .env: the value may contain + / =.
BASIC_AUTH_USER=catalogforge
BASIC_AUTH_HASH='replace-with-base64-encoded-bcrypt-hash'

# --- AI provider -----------------------------------------------------------
# OpenCode Go key. This deployment uses the real key; there is no Groq fallback.
OPENCODE_API_KEY=replace-with-opencode-go-key
AI_PROVIDER=opencode

# --- Worker tuning for 2 GB -------------------------------------------------
# Moderate parallelism; the worker still processes the queue reliably, just less concurrently.
WORKER_BUILD_CONCURRENCY=8
WORKER_TRANSLATE_CONCURRENCY=4
BUILD_BATCH_SIZE=1
TRANSLATE_BATCH_ITEMS=15
DB_POOL_WORKER=8
