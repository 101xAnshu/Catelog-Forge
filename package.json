{
  "name": "catalogforge",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": ["apps/*", "packages/*"],
  "trustedDependencies": ["sharp", "esbuild"],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test packages",
    "test:int": "bun test --timeout 300000 tests/integration",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "worker": "bun run --cwd apps/worker start",
    "eval": "bun run eval/run.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
